{
    "manifest_version": 3,
    "name": "Mnestic",
    "version": "1.0.0",
    "description": "Link your qbank questions to your AnKing Anki cards: resource overlays, one-click cards, weak-area breakdowns, and a tracker.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage",
        "clipboardWrite"
    ],
    "host_permissions": [
        "http://127.0.0.1:8790/*",
        "https://*.coursology-qbank.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://coursology-qbank.com/*",
                "https://*.coursology-qbank.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
